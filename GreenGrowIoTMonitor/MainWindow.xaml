<Window x:Class="GreenGrowIoTMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GreenGrow IoT Monitor" Height="600" Width="620"
        Background="#FFF0F5" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Pink button style, reused by all three buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#D81B60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#AD1457"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F8BBD0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#C2185B" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="GreenGrow IoT Monitor" FontSize="24"
                           FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="txtLocation" Text="Location: Cape Town, South Africa"
                           Foreground="#F8BBD0" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Live readings -->
        <Border Grid.Row="1" Margin="0,12,0,0" Background="White"
                BorderBrush="#F48FB1" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="Current Conditions" FontWeight="Bold" FontSize="16"
                           Foreground="#880E4F"/>
                <TextBlock x:Name="txtTemperature" Text="Temperature: -- °C"
                           FontSize="15" Margin="0,6,0,0" Foreground="#4A1230"/>
                <TextBlock x:Name="txtHumidity" Text="Humidity: -- %"
                           FontSize="15" Foreground="#4A1230"/>
                <TextBlock x:Name="txtWind" Text="Wind Speed: -- km/h"
                           FontSize="15" Foreground="#4A1230"/>
                <TextBlock x:Name="txtSoil" Text="Soil Moisture: -- m³/m³"
                           FontSize="15" Foreground="#4A1230"/>
                <TextBlock x:Name="txtStatus" Text="System Status: OFFLINE"
                           FontWeight="Bold" Foreground="Gray" Margin="0,8,0,0"/>
                <Button x:Name="btnRetrieve" Content="Retrieve New Data" Height="34"
                        Margin="0,10,0,0" Click="btnRetrieve_Click"/>
            </StackPanel>
        </Border>

        <!-- History controls -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="#FCE4EC"
                BorderBrush="#F48FB1" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="Sensor History (Stack)" FontWeight="Bold" FontSize="16"
                           Foreground="#880E4F"/>
                <TextBlock x:Name="txtLatest" Text="Latest Reading: No readings stored"
                           Margin="0,6,0,0" Foreground="#4A1230"/>
                <TextBlock x:Name="txtCount" Text="Stored Readings: 0" Foreground="#4A1230"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="btnPeek" Content="View Latest Reading" Width="170" Height="32"
                            Click="btnPeek_Click"/>
                    <Button x:Name="btnPop" Content="Remove Latest Reading" Width="170" Height="32"
                            Margin="10,0,0,0" Click="btnPop_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Full history list (top = newest) -->
        <ListBox x:Name="lstHistory" Grid.Row="3" Margin="0,12,0,0"
                 Background="White" BorderBrush="#F48FB1" Foreground="#4A1230"/>
    </Grid>
</Window>